<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_the_created_Timing</name>
        <label>Check the created Timing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_task_at_9AM</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>After 2PM</defaultConnectorLabel>
        <rules>
            <name>Created_Timing_before_2PM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCreatedTimeFormula</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>9.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_task_at_5PM</targetReference>
            </connector>
            <label>Before 2PM</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>FollowupDateTimeAt5PMFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Record.CreatedDate})) &amp; &quot; 11:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt9AMnextdayFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Record.CreatedDate}) + 1) &amp; &quot; 03:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>HourofCreatedTimeFormula</name>
        <dataType>Number</dataType>
        <expression>HOUR(TIMEVALUE({!$Record.CreatedDate}))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Create Task on [Lead] Prospect Stage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Task on [Lead] Prospect Stage</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_task_at_5PM</name>
        <label>Create task at 5PM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>A Lead has been Created , make sure to call at 5PM</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Follow_Up_Date_Time__c</field>
            <value>
                <elementReference>FollowupDateTimeAt5PMFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>Prospect</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Call Back - New Lead Created</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Who_ID_Type__c</field>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_task_at_9AM</name>
        <label>Create task at 9AM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>A Lead has been Created , make sure to call at 9AM tomorrow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Follow_Up_Date_Time__c</field>
            <value>
                <elementReference>FollowupDateTimeAt9AMnextdayFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>Prospect</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Call Back - New Lead Created</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Who_ID_Type__c</field>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_the_created_Timing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Prospect</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
