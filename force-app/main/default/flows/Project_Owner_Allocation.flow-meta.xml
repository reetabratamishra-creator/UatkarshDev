        <label>Check with user with Dept&amp;City</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>get_User_with_Dept_State</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Available</defaultConnectorLabel>
        <rules>
            <name>Available_with_Dept_City</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_User_with_Dept_City</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Project_with_Dept_City</targetReference>
            </connector>
