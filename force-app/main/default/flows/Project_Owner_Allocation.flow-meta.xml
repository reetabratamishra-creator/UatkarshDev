    <environments>Default</environments>
    <formulas>
        <name>deptName_shortForm_Formula</name>
        <dataType>String</dataType>
        <expression>IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;High Mast Products&apos;) , &apos;HMS&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Steel Pipes Products&apos;) , &apos;SPP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Polygonal Products&apos;) , &apos;PGP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Crash Barrier Products&apos;) , &apos;CBP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Steel Tubular Poles Products&apos;) , &apos;STPP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;PVC Products&apos;) , &apos;PVC&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;HDPE Products&apos;) , &apos;HPP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Telecom Tower Products&apos;) , &apos;TETP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Transmission Tower Products&apos;) , &apos;TRTP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Railway Electrification Structure Products&apos;) , &apos;RESP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Pre Engineering Buildings Products&apos;) , &apos;PEBP&apos;,

&apos;&apos;)))))))))))</expression>
    </formulas>
    <formulas>
        <name>project_number_formula</name>
        <dataType>String</dataType>
        <expression>&quot;PROJ&quot; + &quot;/&quot; + {!deptName_shortForm_Formula} +&quot;/&quot;+ {!$Record.AutoNumber__c}</expression>
    </formulas>
    <interviewLabel>[Project] Owner Allocation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Project] Owner Allocation</label>
    <processMetadataValues>
