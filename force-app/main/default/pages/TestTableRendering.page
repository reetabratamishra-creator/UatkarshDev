<apex:page standardController="Quote" extensions="QuoteExportController"
           renderAs="pdf" applyBodyTag="false" showHeader="false" standardStylesheets="false">
<head>
<style type="text/css">
@page { size: A4; margin: 15mm; }
body { font-family: sans-serif; font-size: 11.5px; color: #333; }
table {
    width: 100%;
    max-width: 180mm;
    border-collapse: collapse;
    margin-bottom: 15px;
    page-break-inside: avoid;
    table-layout: fixed;
    word-wrap: break-word;
}
th { background-color: #0176d3; color: white; padding: 6px; border: 1px solid #ccc; font-size: 11px; text-align: left;}
td { padding: 6px; border: 1px solid #ccc; font-size: 11px; vertical-align: top;}

table.peb-spec-table {
    width: 100%;
    max-width: 180mm;
    border-collapse: collapse;
    border-spacing: 0;
    margin-top: 4px;
    margin-bottom: 8px;
    page-break-inside: auto;
}
table.peb-spec-table th,
table.peb-spec-table td {
    border: 1px solid #000000;
    padding: 3px 5px;
    font-size: 9.5px;
    color: #000000;
    vertical-align: top;
    word-wrap: break-word;
}
table.peb-spec-table th {
    font-weight: bold;
    background-color: #ffffff;
}
table.peb-spec-table tr.subhead-row td {
    font-weight: bold;
    background-color: #ffffff;
}
table.peb-spec-table tr {
    page-break-inside: avoid;
}
</style>
</head>
<body>
<apex:repeat value="{!docSections}" var="sec">
    <apex:outputPanel layout="none" rendered="{!sec.isTable}">
        <p style="font-weight: bold;"><apex:outputText value="{!sec.title}"/></p>
        <apex:outputText value="{!sec.tableHtml}" escape="false"/>
    </apex:outputPanel>
</apex:repeat>
</body>
</apex:page>